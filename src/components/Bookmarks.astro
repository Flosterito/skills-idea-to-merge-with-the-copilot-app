---
---
<form id="add-bookmark" novalidate>
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="example.com or https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Add a link with or without <code>https://</code> to create its short <code>mona-</code> slug.</p>

<p id="status" role="status" aria-live="polite" aria-atomic="true"></p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import { formatBookmark, loadBookmarks, normalizeUrl } from '../lib/bookmarks.mjs';

  type Bookmark = {
    url: string;
    slug: string;
  };

  const storageKey = 'mona-bookmarks';
  const legacyStorageKey = 'mona-bookmarks-v1';
  const alphabet = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const slugLength = 4;
  const form = document.querySelector<HTMLFormElement>('#add-bookmark');
  const urlInput = document.querySelector<HTMLInputElement>('#url');
  const list = document.querySelector<HTMLUListElement>('#bookmark-list');
  const emptyState = document.querySelector<HTMLParagraphElement>('#empty-state');
  const listHeader = document.querySelector<HTMLDivElement>('#list-header');
  const clearAllButton = document.querySelector<HTMLButtonElement>('#clear-all');
  const status = document.querySelector<HTMLParagraphElement>('#status');

  if (!form || !urlInput || !list || !emptyState || !listHeader || !clearAllButton || !status) {
    throw new Error('The bookmarks interface is missing required elements.');
  }

  let bookmarks: Bookmark[] = [];
  let storageReady = false;

  function setStatus(message: string, isError = false) {
    status.textContent = message;
    status.setAttribute('role', isError ? 'alert' : 'status');
    status.setAttribute('aria-live', isError ? 'assertive' : 'polite');
  }

  function generateSlug(): string {
    for (let attempt = 0; attempt < 10; attempt += 1) {
      const characters: string[] = [];

      while (characters.length < slugLength) {
        const bytes = new Uint8Array(slugLength - characters.length);
        crypto.getRandomValues(bytes);

        for (const byte of bytes) {
          if (byte < 248) {
            characters.push(alphabet.charAt(byte % alphabet.length));
          }
        }
      }

      const slug = `mona-${characters.join('')}`;
      if (!bookmarks.some((bookmark) => bookmark.slug === slug)) {
        return slug;
      }
    }

    throw new Error('Could not create a unique slug. Please try again.');
  }

  function renderBookmarks() {
    list.replaceChildren();

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const label = document.createElement('span');
      label.className = 'bookmark-label';

      const formatted = formatBookmark(bookmark);
      const separator = ' :: ';
      const separatorIndex = formatted.lastIndexOf(separator);
      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = formatted.slice(0, separatorIndex);

      const divider = document.createElement('span');
      divider.className = 'separator';
      divider.textContent = formatted.slice(separatorIndex, separatorIndex + separator.length);

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = formatted.slice(separatorIndex + separator.length);

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          setStatus(`Copied ${bookmark.slug} to the clipboard.`);
        } catch {
          setStatus('Could not copy the slug. Check clipboard permissions and try again.', true);
        }
      });

      label.append(link, divider, slug);
      item.append(label, copyButton);
      list.append(item);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();

    if (!storageReady) {
      setStatus('Bookmarks are unavailable because browser storage could not be read.', true);
      return;
    }

    const url = normalizeUrl(urlInput.value);
    if (!url) {
      setStatus('Enter a valid web address, such as example.com or https://example.com.', true);
      urlInput.focus();
      return;
    }

    let slug: string;
    try {
      slug = generateSlug();
    } catch {
      setStatus('Could not generate a unique slug. Please try again.', true);
      return;
    }

    const nextBookmarks = [{ url, slug }, ...bookmarks];
    try {
      localStorage.setItem(storageKey, JSON.stringify(nextBookmarks));
    } catch {
      setStatus('Could not save the bookmark. Check browser storage availability and try again.', true);
      return;
    }

    bookmarks = nextBookmarks;
    renderBookmarks();
    form.reset();
    urlInput.focus();
    setStatus(`Saved ${slug}.`);
  });

  clearAllButton.addEventListener('click', () => {
    if (!storageReady || !window.confirm('Clear all saved bookmarks?')) {
      return;
    }

    try {
      localStorage.removeItem(storageKey);
    } catch {
      setStatus('Could not clear bookmarks from browser storage. Please try again.', true);
      return;
    }

    bookmarks = [];
    renderBookmarks();
    setStatus('All bookmarks cleared.');
  });

  try {
    const stored = localStorage.getItem(storageKey);
    const legacyStored = stored === null ? localStorage.getItem(legacyStorageKey) : null;
    const source = stored ?? legacyStored;
    bookmarks = loadBookmarks(source);

    const cleaned = JSON.stringify(bookmarks);
    if ((stored === null && legacyStored !== null) || (stored !== null && stored !== cleaned)) {
      localStorage.setItem(storageKey, cleaned);
    }
    storageReady = true;
    renderBookmarks();
  } catch {
    renderBookmarks();
    setStatus('Could not access browser storage. Bookmarks will be available when storage is enabled.', true);
  }
</script>
