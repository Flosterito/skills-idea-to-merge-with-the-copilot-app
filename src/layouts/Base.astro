---
const { title = "Mona's Bookmark Manager App" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      /* Monaspace webfonts (GitHub Next, SIL OFL 1.1) self-hosted from /public/fonts.
         Neon carries body text; Xenon gives headings a touch of contrast.
         Self-hosting keeps the app fully offline-capable — no runtime CDN needed;
         the ui-monospace fallback still covers any load failure. */
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-400.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-700.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-700.woff2') format('woff2');
      }
      :root {
        color-scheme: light dark;
        --accent: #3b82f6;
        --border: #8883;
        --muted: color-mix(in srgb, currentColor 60%, transparent);
        --radius: 0.6rem;
        --font-body: 'Monaspace Neon', ui-monospace, 'SF Mono', 'Cascadia Code', monospace;
        --font-head: 'Monaspace Xenon', 'Monaspace Neon', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      body {
        font-family: var(--font-body);
        line-height: 1.5;
        color: CanvasText;
        background:
          radial-gradient(ellipse at 50% 0, color-mix(in srgb, var(--accent) 12%, transparent), transparent 65%),
          Canvas;
        min-height: 100vh;
        max-width: 44rem;
        margin: 0 auto;
        padding: clamp(2rem, 8vh, 4.5rem) 1.25rem 4rem;
      }
      header { margin-bottom: 2rem; }
      h1 { margin: 0 0 0.5rem; font-size: clamp(1.5rem, 5vw, 2rem); font-family: var(--font-head); letter-spacing: -0.03em; }
      .tagline { margin: 0; color: var(--muted); }

      main {
        padding: clamp(1rem, 4vw, 1.5rem);
        border: 1px solid var(--border);
        border-radius: calc(var(--radius) * 1.5);
        background: color-mix(in srgb, Canvas 94%, transparent);
        box-shadow: 0 1rem 3rem color-mix(in srgb, currentColor 8%, transparent);
      }
      form {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: end;
        margin: 1.5rem 0 0.5rem;
      }
      .field { display: flex; flex-direction: column; gap: 0.4rem; flex: 1 1 16rem; min-width: 0; }
      label { font-size: 0.85rem; font-weight: 600; }
      input {
        width: 100%;
        padding: 0.7rem 0.8rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        font: inherit;
        background: transparent;
        color: inherit;
      }
      input:focus-visible,
      button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      button {
        padding: 0.7rem 1rem;
        border: 1px solid transparent;
        border-radius: var(--radius);
        background: var(--accent);
        color: #fff;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
        transition: filter 150ms ease, transform 150ms ease;
      }
      button:hover { filter: brightness(1.08); transform: translateY(-1px); }
      .hint { margin: 0 0 1.5rem; font-size: 0.8rem; color: var(--muted); }
      .hint code { color: var(--accent); }
      #status:empty { display: none; }
      #status:not(:empty) { margin: 0 0 1rem; font-size: 0.85rem; }

      #list-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin: 0.5rem 0;
      }
      .list-title { margin: 0; font-size: 1rem; font-family: var(--font-head); }
      .clear {
        background: transparent;
        color: inherit;
        border: 1px solid var(--border);
        padding: 0.35rem 0.7rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .clear:hover { border-color: currentColor; }

      ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
      li.bookmark {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem 1rem;
        padding: 0.75rem 0.9rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: color-mix(in srgb, Canvas 97%, var(--accent));
        transition: border-color 150ms ease, transform 150ms ease;
      }
      li.bookmark:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); transform: translateY(-1px); }
      .bookmark-label { display: flex; align-items: baseline; flex: 1 1 16rem; min-width: 0; }
      .bookmark .url { min-width: 0; overflow-wrap: anywhere; }
      .bookmark .separator { white-space: pre; color: var(--muted); }
      .bookmark .slug {
        flex: 0 0 auto;
        font-family: var(--font-body);
        font-size: 0.85rem;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--accent) 18%, transparent);
      }
      .bookmark .copy {
        background: transparent;
        color: inherit;
        border: 1px solid var(--border);
        padding: 0.3rem 0.6rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .empty {
        margin: 0;
        padding: 2rem 1rem;
        text-align: center;
        color: var(--muted);
        border: 1px dashed var(--border);
        border-radius: var(--radius);
      }

      footer { margin-top: 1.5rem; text-align: center; font-size: 0.8rem; color: var(--muted); }
      @media (max-width: 32rem) {
        form > button { width: 100%; }
        .bookmark-label { flex-basis: 100%; }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
